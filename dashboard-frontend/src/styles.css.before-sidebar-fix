/* Global Railway Intelligence Map */
.global-map-panel {
  margin-bottom: 18px;
}

.global-map-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 14px;
}

.global-map-header h2 {
  margin: 4px 0 6px;
}

.global-map-header p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.eyebrow {
  color: #42d6c5;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.global-map-controls {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.map-control {
  border: 1px solid #24455c;
  background: #0d1b2a;
  color: #8fa9bc;
  border-radius: 6px;
  padding: 7px 11px;
  font-size: 11px;
  cursor: pointer;
}

.map-control.active {
  background: #123b43;
  border-color: #2cc9bb;
  color: #b9fff5;
}

.global-map {
  position: relative;
  min-height: 520px;
  overflow: hidden;
  border: 1px solid #1d4257;
  border-radius: 8px;
  background: #06131f;
}

.map-ocean {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 45%, rgba(23, 91, 107, 0.2), transparent 45%),
    #06131f;
}

.map-grid-line {
  position: absolute;
  display: block;
  pointer-events: none;
  opacity: 0.22;
}

.map-grid-line.latitude {
  left: 0;
  width: 100%;
  height: 1px;
  background: #285267;
}

.map-grid-line.longitude {
  top: 0;
  width: 1px;
  height: 100%;
  background: #285267;
}

.continent {
  position: absolute;
  background: #102b38;
  border: 1px solid #1a4655;
  opacity: 0.95;
  box-shadow: 0 0 30px rgba(31, 134, 139, 0.06);
}

.continent-north-america {
  left: 11%;
  top: 25%;
  width: 20%;
  height: 25%;
  border-radius: 48% 35% 42% 55%;
  transform: rotate(-12deg);
}

.continent-south-america {
  left: 27%;
  top: 51%;
  width: 10%;
  height: 27%;
  border-radius: 45% 55% 65% 35%;
  transform: rotate(15deg);
}

.continent-europe {
  left: 48%;
  top: 27%;
  width: 10%;
  height: 10%;
  border-radius: 50%;
}

.continent-africa {
  left: 47%;
  top: 39%;
  width: 13%;
  height: 27%;
  border-radius: 42% 55% 48% 40%;
  transform: rotate(7deg);
}

.continent-asia {
  left: 57%;
  top: 23%;
  width: 28%;
  height: 30%;
  border-radius: 48% 32% 55% 40%;
  transform: rotate(4deg);
}

.continent-australia {
  left: 76%;
  top: 63%;
  width: 12%;
  height: 12%;
  border-radius: 48% 55% 42% 50%;
  transform: rotate(-8deg);
}

.rail-route {
  position: absolute;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(52, 215, 198, 0.7), transparent);
  transform-origin: left center;
  opacity: 0.65;
}

.route-europe-asia {
  left: 51%;
  top: 34%;
  width: 31%;
  transform: rotate(-3deg);
}

.route-india {
  left: 63%;
  top: 48%;
  width: 15%;
  transform: rotate(20deg);
}

.route-north-america {
  left: 15%;
  top: 39%;
  width: 18%;
  transform: rotate(8deg);
}

.global-train-marker {
  position: absolute;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #d9f7f3;
  cursor: pointer;
  transform: translate(-50%, -50%);
  white-space: nowrap;
}

.global-train-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #35d6c5;
  box-shadow: 0 0 0 4px rgba(53, 214, 197, 0.12), 0 0 16px rgba(53, 214, 197, 0.8);
}

.global-train-label {
  padding: 3px 6px;
  border: 1px solid #25495b;
  border-radius: 4px;
  background: rgba(5, 17, 27, 0.92);
  font-size: 10px;
}

.global-train-marker.predicted .global-train-dot {
  background: #d5a94c;
  box-shadow: 0 0 0 4px rgba(213, 169, 76, 0.12), 0 0 16px rgba(213, 169, 76, 0.7);
}

.global-train-marker.scheduled .global-train-dot {
  background: #6696c7;
  box-shadow: 0 0 0 4px rgba(102, 150, 199, 0.12), 0 0 14px rgba(102, 150, 199, 0.65);
}

.global-train-marker.last-known .global-train-dot {
  background: #9b7bc7;
  box-shadow: 0 0 0 4px rgba(155, 123, 199, 0.12), 0 0 14px rgba(155, 123, 199, 0.6);
}

.map-overlay {
  position: absolute;
  z-index: 10;
  border: 1px solid #214658;
  border-radius: 6px;
  background: rgba(5, 17, 27, 0.9);
  backdrop-filter: blur(8px);
}

.map-status {
  left: 14px;
  top: 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 10px 12px;
  color: #7894a6;
  font-size: 10px;
}

.map-status strong {
  color: #9eece3;
  font-size: 10px;
  letter-spacing: 0.1em;
}

.map-legend-global {
  right: 14px;
  bottom: 14px;
  display: flex;
  gap: 12px;
  padding: 9px 11px;
  color: #9ab0bf;
  font-size: 9px;
  letter-spacing: 0.04em;
}

.map-legend-global span {
  display: flex;
  align-items: center;
  gap: 5px;
}

.map-legend-global i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  display: inline-block;
}

.legend-live {
  background: #35d6c5;
}

.legend-predicted {
  background: #d5a94c;
}

.legend-scheduled {
  background: #6696c7;
}

.legend-last-known {
  background: #9b7bc7;
}

.map-attribution {
  position: absolute;
  left: 14px;
  bottom: 14px;
  color: #4e6878;
  font-size: 9px;
}

@media (max-width: 900px) {
