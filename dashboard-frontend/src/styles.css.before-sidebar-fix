* { box-sizing: border-box; }
:root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #dce9f7; background: #04101d; font-synthesis: none; }
body { margin: 0; min-width: 1100px; background: radial-gradient(circle at 55% -10%, #0a2743 0, #04101d 42%, #030b14 100%); }
button, input { font: inherit; }
button { color: inherit; }
.shell { display: flex; min-height: 100vh; }
.sidebar { width: 190px; flex: 0 0 190px; background: rgba(3, 18, 34, .96); border-right: 1px solid #12314d; display: flex; flex-direction: column; padding: 18px 10px; position: sticky; top: 0; height: 100vh; }
.brand { display: flex; gap: 10px; align-items: center; padding: 0 9px 20px; border-bottom: 1px solid #12314d; }
.brand-mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; color: #5ecbff; background: #0a2946; font-size: 22px; }
.brand strong { display: block; font-size: 15px; letter-spacing: .01em; color: #f4f9ff; }
.brand span { display: block; margin-top: 3px; font-size: 8px; color: #6e8da8; white-space: nowrap; }
nav { display: grid; gap: 5px; padding-top: 18px; }
.nav-item { border: 0; background: transparent; padding: 10px 10px; border-radius: 7px; text-align: left; color: #88a2ba; font-size: 12px; display: flex; align-items: center; gap: 11px; cursor: pointer; }
.nav-item:hover { background: #09233b; color: #e7f4ff; }.nav-item.active { background: linear-gradient(90deg, #0879df, #0b63bb); color: #fff; box-shadow: 0 6px 20px rgba(0, 126, 235, .2); }.nav-icon { width: 16px; text-align: center; color: #8bbbe0; }.nav-item b { margin-left: auto; background: #ef4059; color: white; border-radius: 999px; min-width: 18px; text-align: center; font-size: 10px; padding: 2px 5px; }
.sidebar-footer { margin-top: auto; border-top: 1px solid #12314d; padding: 14px 10px 2px; color: #6e8da8; font-size: 10px; display: flex; gap: 7px; align-items: center; }
.main { flex: 1; min-width: 0; padding: 0 18px 28px; }.topbar { height: 76px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(18,49,77,.75); }.eyebrow { color: #5e8db3; font-size: 9px; letter-spacing: .16em; font-weight: 700; }.topbar h1 { margin: 2px 0 0; font-size: 21px; color: #f2f7fc; }.topbar-right { display: flex; align-items: center; gap: 22px; }.system-state { font-size: 11px; color: #b7c9da; display: flex; align-items: center; gap: 7px; }.online-dot,.offline-dot,.warning-dot { width: 8px; height: 8px; display: inline-block; border-radius: 50%; }.online-dot { background: #13cf79; box-shadow: 0 0 10px rgba(19,207,121,.5); }.offline-dot { background: #ef4059; }.warning-dot { background: #f0b429; }.bell { position: relative; color: #90a9c0; font-size: 21px; }.bell b { position: absolute; right: -7px; top: -4px; background: #ef4059; color: white; font-size: 8px; min-width: 15px; height: 15px; border-radius: 50%; display: grid; place-items: center; }.user { display: flex; align-items: center; gap: 8px; }.avatar { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: #dbe9f5; color: #12314d; font-weight: 800; }.user strong,.user span { display: block; }.user strong { font-size: 11px; }.user span { font-size: 9px; color: #69839b; margin-top: 2px; }.global-error { background: #5b1f2b; border: 1px solid #a33a50; color: #ffbdc8; margin-top: 14px; padding: 10px 12px; border-radius: 7px; font-size: 11px; }
.dashboard-content { padding-top: 14px; }.overview-strip { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; margin-bottom: 12px; }.metric { min-height: 86px; border: 1px solid #123652; border-radius: 8px; background: linear-gradient(145deg, rgba(8,35,59,.94), rgba(5,24,41,.94)); display: flex; align-items: center; gap: 12px; padding: 12px; box-shadow: inset 0 1px rgba(255,255,255,.025); }.metric-icon { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 10px; font-size: 21px; }.metric.blue .metric-icon { background:#093c66;color:#29a9ff }.metric.green .metric-icon { background:#073f36;color:#2be4a1 }.metric.purple .metric-icon { background:#271f58;color:#a38cff }.metric.red .metric-icon { background:#552033;color:#ff5c73 }.metric span,.metric small { display:block;color:#718da7;font-size:9px }.metric strong { display:block;font-size:22px;line-height:1.1;margin:4px 0 2px;color:#f4f8fc }.metric.red strong{color:#ff5570}
.panel { background: linear-gradient(150deg, rgba(6,26,45,.98), rgba(4,19,33,.98)); border: 1px solid #123652; border-radius: 8px; box-shadow: 0 12px 28px rgba(0,0,0,.16); }.map-panel { padding: 12px 14px 7px; margin-bottom: 12px; }.panel-title { display:flex;align-items:center;justify-content:space-between;margin-bottom:10px }.panel-title h3 { margin:0; font-size:12px; letter-spacing:.02em; color:#dceafa; }.panel-title button { border:0;background:transparent;color:#3daaff;font-size:9px;cursor:pointer }.timestamp { font-size:9px;color:#58758f }.three-col { display:grid; grid-template-columns: 1.1fr .9fr; gap:10px; margin-bottom:12px }.three-col.equal { grid-template-columns: repeat(3,1fr) }.three-col.lower { grid-template-columns: 1.45fr .85fr .9fr }
